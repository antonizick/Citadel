# ── Runtime & User Data (Nx-Citadel specific) ────────────────────

# All user data — interests, reports, IOCs, config, users
data/

# Live log file (archives may be backed up separately)
logs/
*.log

# PID file from StartCitadel.sh
.citadel.pid

# Deployment artifacts
deploy/archived/
deploy/nxcitadel-*.tar.gz
deploy/nxcitadel-latest.tar.gz

# Build / download scripts (deploy/install.sh and deploy/build_package.sh stay tracked)
deploy/get.sh.bak

